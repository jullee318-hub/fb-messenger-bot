# ===== Facebook 設定 =====
# 從 Meta 開發者後台取得
FB_PAGE_ACCESS_TOKEN=你的粉專存取權杖
FB_VERIFY_TOKEN=自訂一組驗證密碼（例如：pinhuibot2024）
FB_APP_SECRET=你的應用程式密鑰

# ===== Claude AI 設定 =====
# 從 https://console.anthropic.com/ 取得
ANTHROPIC_API_KEY=你的Claude_API金鑰

# ===== LINE 設定 =====
# 你的 LINE 官方帳號連結
LINE_URL=https://line.me/R/ti/p/你的LINE_ID

# ===== 伺服器設定 =====
PORT=3000
